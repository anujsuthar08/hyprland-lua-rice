/* GENERATED BY MATUGEN — do not edit.
   Regenerate: matugen image <wallpaper> */
* {
    bg:            {{colors.surface.default.hex}};
    bg-alt:        {{colors.surface_container.default.hex}};
    bg-selected:   {{colors.primary.default.hex}};
    fg:            {{colors.on_surface.default.hex}};
    fg-selected:   {{colors.on_primary.default.hex}};
    primary:       {{colors.primary.default.hex}};
    outline:       {{colors.outline.default.hex}};
    urgent:        {{colors.error.default.hex}};

    /* rofi cannot alpha-modify a variable, so the translucent variants
       the glass launcher needs are emitted as 8-digit hex (#rrggbbaa).
       glass = surface @ 0.66 (same as the bar dropdowns), tint = primary
       @ 0.20 (the selected row), hover/hair = on_surface @ 0.10. */
    glass:         #{{colors.surface.default.hex_stripped}}a8;
    tint:          #{{colors.primary.default.hex_stripped}}33;
    hover:         #{{colors.on_surface.default.hex_stripped}}1a;
    hair:          #{{colors.on_surface.default.hex_stripped}}1a;
    rim:           #ffffff14;
}
